# Agent-Wrapper configuration. Copy to .env and edit.

# --- Central-Dispatch (optional) ---
# Both are optional. CENTRAL_URL defaults to the hosted Bizzybot; override only
# to point at your own Central-Dispatch. If REGISTRATION_TOKEN is unset, the agent-wrapper prompts
# for it on first run and caches it in .agent-wrapper-config.json.
# CENTRAL_URL=http://localhost:3000
# REGISTRATION_TOKEN=

# --- Claude ---
# One of: default | acceptEdits | plan | bypassPermissions
# bypassPermissions = no approval prompts (there's no approval UI in Slack).
CLAUDE_PERMISSION_MODE=bypassPermissions

# Optional: pin the model. Leave blank for Claude's default. Ignored if this
# agent is configured for OpenRouter (see settings.env.example).
# CLAUDE_MODEL=claude-opus-4-8

# Directory the agent starts each thread in. Defaults to the directory you
# launched bizzybot from.
# CLAUDE_CWD=/path/to/your/project

# Which setting sources the spawned `claude` inherits (comma-separated subset of
# user,project,local). Loads your slash commands, agents, and skills.
CLAUDE_SETTING_SOURCES=user,project,local

# Load MCP servers you've added via `claude mcp add` (1=on, 0=off).
# CLAUDE_LOAD_CLI_MCP=1

# Start each claude with --chrome (Claude-in-Chrome browser MCP). On by default;
# set to 0 to disable.
# CLAUDE_CHROME=1

# --- PR review poller (optional) ---
# When PR_REVIEW_CHANNEL is set, the wrapper polls GitHub for pull requests that
# request a review from this machine's `gh` account, opens a thread in that
# channel, and runs a Claude turn that reviews the PR and submits the review with
# `gh pr review`. Unset = off. Needs `gh` installed and authenticated.
# Use a channel ID (C…) and invite the bot to that channel first.
# PR_REVIEW_CHANNEL=C0123456789

# Whose pending review requests to watch. Default @me = whoever `gh` is logged in
# as, which on an agent machine is the bot account. Also takes an explicit login
# or an @org/team.
# PR_REVIEW_LOGIN=@me

# Poll cadence in seconds (default 60, floor 10).
# PR_POLL_INTERVAL_S=60

# Note: requests already pending when the wrapper starts are recorded as seen and
# skipped, so a restart doesn't re-review a backlog. To trigger one of those,
# remove and re-add the reviewer.

# --- Sentry watch poller (optional) ---
# When SENTRY_WATCH_CHANNEL is set (and SENTRY_API_TOKEN holds a token), the
# wrapper polls Sentry for new unresolved production issues, opens a thread in
# that channel per issue, and runs a Claude turn that triages it via the
# sentry-triage skill. Unset = off.
# Use a channel ID (C…) and invite the bot to that channel first.
# SENTRY_WATCH_CHANNEL=C0123456789

# Read-only Sentry auth token with the event:read scope (a personal token or an
# internal integration; org tokens cannot list issues).
# SENTRY_API_TOKEN=sntrys_...

# Sentry organization slug (default biztrip-ai).
# SENTRY_ORG=biztrip-ai

# Poll cadence in seconds (default 900, floor 60).
# SENTRY_POLL_INTERVAL_S=900

# Note: issues already unresolved when the poller first runs are recorded in
# ~/.bizzybot/sentry-watch-ledger.json and skipped, so enabling the feature
# doesn't dump the backlog into Slack. Ask bizzy to triage one of those by hand.

# --- Sentry Slack-alert hook (optional) ---
# When SENTRY_ALERT_CHANNEL is set, the wrapper watches that channel for the
# Sentry Slack app's alert messages and runs the triage in each alert's own
# thread, immediately — no duplicate announce. The poller above then acts as
# the slow safety net (set SENTRY_POLL_INTERVAL_S=3600); both share the ledger.
# The bot must be a member of the channel.
# SENTRY_ALERT_CHANNEL=C0123456789

# Restrict the hook to one app's messages (Slack app id of the Sentry app).
# Unset = any bot message in the channel triggers.
# SENTRY_ALERT_APP_ID=A0123ABCD

# --- Misc ---
LOG_LEVEL=INFO

# On macOS the wrapper runs `caffeinate` automatically to stop the Mac idle-
# sleeping (which would drop its connection to Central-Dispatch). Set this to
# disable that. No effect off macOS.
# BIZZYBOT_NO_CAFFEINATE=1
