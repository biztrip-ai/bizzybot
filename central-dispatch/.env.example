# Central-Dispatch configuration. Copy to .env and edit.

# HTTP server
PORT=3000
PUBLIC_URL=http://localhost:3000

# Local HTTPS: set TLS_SELF_SIGNED=1 and PUBLIC_URL=https://localhost:3000 to
# serve TLS with an auto-generated self-signed cert, so Slack's OAuth redirect to
# https://localhost works without a tunnel. Requires `openssl` on PATH. Leave OFF
# on Railway (the platform terminates TLS; the app listens plain HTTP behind it).
# TLS_SELF_SIGNED=1

# Storage. If DATABASE_URL is set, Central-Dispatch uses Postgres (e.g. Neon) with a
# dedicated schema (DB_SCHEMA, default "claudebot") so it can safely share a
# database with other apps. If unset, it falls back to a local SQLite file.
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# DB_SCHEMA=claudebot
DB_PATH=./central-dispatch.db

# Signs the "Sign in with Slack" dashboard session cookie. Set this in prod so
# sessions survive restarts (a random value is used if unset, dropping sessions
# on every restart). Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Slack (pre-built app).
# Create the app once from GET /slack/manifest, then fill these in from its
# "Basic Information" page. The signing secret verifies inbound webhooks; the
# client id/secret drive the "Add to Slack" OAuth flow; the per-workspace bot
# token is obtained during OAuth and handed to agents when they register.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_APP_NAME=Bizzybot

# Optional fallback bot token for the admin (no-OAuth) path only.
SLACK_BOT_TOKEN=

# --- Inbound email (optional; see docs/EMAIL.md) ---
# Central polls Mailgun and routes inbound mail to agents. Mailgun domain + API
# key are configured per-workspace in the dashboard, not here. These two tune
# the shared poller:
# How often to poll each workspace's Mailgun, in seconds.
# EMAIL_POLL_INTERVAL_S=60
# Instance-wide last-resort allowed sender domain(s) (comma-separated). Normally
# the allow-list is set per-workspace (and optionally per-agent) in the dashboard;
# this env only applies when neither is set — useful for single-org self-hosting.
# The sender allow-list is the trust boundary: with none of the three set, an
# agent receives NO mail (closed by default).
# EMAIL_SENDER_DOMAIN=biztrip.ai
